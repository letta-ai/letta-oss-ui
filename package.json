{
	"name": "letta-oss-ui",
	"productName": "OSS-UI",
	"private": true,
	"version": "0.2.0",
	"description": "Desktop app for working with Letta agents",
	"author": "Letta",
	"license": "Apache-2.0",
	"type": "module",
	"main": "dist-electron/main.js",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"dev": "concurrently -k --kill-others-on-fail \"bun run dev:react\" \"bun run dev:electron\"",
		"dev:react": "vite",
		"dev:electron": "bun run transpile:electron && cross-env NODE_ENV=development electron .",
		"build": "tsc -b && vite build",
		"typecheck": "tsc -b && tsc --project src/electron/tsconfig.json --noEmit && tsc --project tests/tsconfig.json",
		"lint": "eslint .",
		"test": "vitest run",
		"check": "bun run typecheck && bun run lint && bun run test",
		"preview": "vite preview",
		"transpile:electron": "tsc --project src/electron/tsconfig.json",
		"dist:mac-arm64": "bun run transpile:electron && bun run build && electron-builder --mac --arm64",
		"dist:mac-x64": "bun run transpile:electron && bun run build && electron-builder --mac --x64",
		"dist:win": "bun run transpile:electron && bun run build && electron-builder --win --x64",
		"dist:linux": "bun run transpile:electron && bun run build && electron-builder --linux --x64"
	},
	"dependencies": {
		"@letta-ai/letta-agent-sdk": "0.8.32",
		"@letta-ai/letta-code": "0.34.6"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@tailwindcss/vite": "^4.1.18",
		"@types/node": "^22.19.0",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.1.2",
		"concurrently": "^10.0.6",
		"cross-env": "^10.1.0",
		"electron": "^44.7.0",
		"electron-builder": "^26.15.3",
		"eslint": "^10.12.0",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"globals": "^17.0.0",
		"highlight.js": "^11.11.1",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"react-markdown": "^10.1.0",
		"rehype-highlight": "^7.0.2",
		"remark-gfm": "^4.0.1",
		"tailwindcss": "^4.1.18",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.4",
		"vitest": "^5.0.3",
		"zustand": "^5.0.10"
	},
	"trustedDependencies": [
		"@letta-ai/letta-code",
		"electron"
	],
	"overrides": {
		"@letta-ai/letta-agent-sdk": "0.8.32",
		"@letta-ai/letta-code": "0.34.6"
	}
}
